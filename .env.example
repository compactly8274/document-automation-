# ── Docker socket proxy URLs ──────────────────────────────────────────────────
# Tecnativa docker-socket-proxy must have CONTAINERS=1, IMAGES=1, EVENTS=1
# Use unix:// for local socket, or tcp:// for remote (requires TLS in production)
UNRAID_SOCKET_URL=
TRUENAS_SOCKET_URL=

# Set to 1 to require TLS client certificates for TCP sockets
DOCKER_TLS_VERIFY=0

# ── Domain ────────────────────────────────────────────────────────────────────
DOMAIN=

# ── Optional: auto-push docs to a private GitHub repo ────────────────────────
# Use a FINE-GRAINED PAT scoped to this single repo with Contents: Read+Write.
# Do NOT use a classic PAT or a token with broader org/user scope.
# Generate: GitHub → Settings → Developer settings → Personal access tokens
#   → Fine-grained tokens → Generate new token
#   - Resource owner: your account
#   - Repository access: Only select repositories → pick the docs repo
#   - Repository permissions → Contents: Read and Write
#   - Expiration: 90 days (never "No expiration")
# See README "Auto-push to GitHub" for the full walkthrough and branch advice.
# GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx
# GITHUB_REPO=yourname/homelab-docs
# GITHUB_BRANCH=docs   # recommend a non-main branch on first push — see README

# ── Timing ────────────────────────────────────────────────────────────────────
DEBOUNCE_SECONDS=10
REGEN_INTERVAL=3600
REGENERATE_ON_START=true

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Web UI ───────────────────────────────────────────────────────────────────
# Host port the homedocs web UI is published on. Defaults to 27531 (an uncommon
# port chosen to avoid collisions with common service defaults). Inside the
# container the app always listens on 8080.
WEB_PORT=27531
