# ── Docker socket proxy URLs ──────────────────────────────────────────────────
# Tecnativa docker-socket-proxy must have CONTAINERS=1, IMAGES=1, EVENTS=1
UNRAID_SOCKET_URL=tcp://192.168.1.104:2375
TRUENAS_SOCKET_URL=tcp://192.168.1.122:2375

# ── Domain ────────────────────────────────────────────────────────────────────
DOMAIN=pancakefarts.xyz

# ── Optional: auto-push docs to a private GitHub repo ────────────────────────
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# GITHUB_REPO=yourname/homelab-docs
# GITHUB_BRANCH=main

# ── Timing ────────────────────────────────────────────────────────────────────
DEBOUNCE_SECONDS=10
REGEN_INTERVAL=3600
REGENERATE_ON_START=true

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
